# Copy this file to .env and fill in real values. Every variable below is
# actually read somewhere in the codebase (verified by grepping for
# process.env usage) - this file intentionally does not list variables for
# features that don't exist yet.

# MongoDB Atlas (or any Mongo) connection string. Used by src/lib/dbConnect.ts.
MONGODB_URI=

# Alchemy API key. Used by src/app/api/price/route.ts,
# src/app/api/historical-prices/route.ts, and src/worker/priceProcessor.ts.
# Get one at https://dashboard.alchemy.com - the free tier is capped at
# 300 token_price requests/hour, which is worth knowing before load testing.
ALCHEMY_API_KEY=

# Redis connection. Used by src/lib/redisConnect.ts (the price cache),
# src/lib/priceHistoryQueue.ts and src/worker/priceWorker.ts (the BullMQ
# queue). All three now share the same default port (6379) when
# REDIS_PORT is unset - they previously defaulted to different ports.
#
# Prefer a local Redis (see README "Local-first development") over a free
# cloud tier for day-to-day work: a free Redis Cloud instance used earlier
# in this project was reclaimed after a period of inactivity, silently
# breaking anything that depended on it. Cloud Redis is still fine for
# shared/staging use - just don't make it the only place development happens.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker tuning (src/worker/priceWorker.ts, src/lib/alchemyRateLimiter.ts).
# Both default sensibly if unset - only set these if you need to change them.
#
# How many backfill jobs one worker PROCESS runs concurrently. Running
# multiple worker processes multiplies this further - see README "Running
# the worker" for how. Does NOT bound Alchemy traffic - see ALCHEMY_RPS.
WORKER_CONCURRENCY=5
#
# Requests per second against Alchemy's token_price quota, shared across
# every worker process via a Redis-backed pacer (not BullMQ's queue
# limiter - see README "Running the worker" for why). Left unset here on
# purpose: the code default is the *exact* fraction 300/3600 (Alchemy's
# real free-tier ceiling: 300 token_price requests/hour, confirmed via the
# literal error text, not a guess), computed in code rather than written
# here as a rounded decimal, so the common case has no precision loss.
# Override with a real number (e.g. ALCHEMY_RPS=2) if you're on a paid
# Alchemy tier with a higher limit.
ALCHEMY_RPS=

# API-key authentication (src/lib/apiAuth.ts). Env-var allowlist, not
# Mongo-hashed keys - see the comment at the top of apiAuth.ts for why.
# Comma-separated `key` or `key:scope` pairs; a bare key defaults to
# "read" scope. Only "admin"-scoped keys (or a dashboard session - see
# DASHBOARD_USERNAME/PASSWORD below) can call admin-gated routes like
# POST /api/schedule. Example: API_KEYS=devkey123,ci-key456:admin
API_KEYS=

# Dashboard login (src/lib/authOptions.ts, next-auth Credentials provider).
# Single hardcoded credential pair - there's no self-service registration,
# by design (see src/app/(auth)/signup/page.tsx). Anyone with a valid
# session is treated as admin, since this project has exactly one account.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Required by next-auth to sign/encrypt session JWTs. Generate one with
# `openssl rand -base64 32` (or any sufficiently random string) - do not
# reuse a value from another project or leave this blank in production.
NEXTAUTH_SECRET=

# Lets scripts/benchmark.mjs (--bypass-cache) measure genuine uncached
# upstream latency by sending x-bypass-cache on /api/price requests. Unset
# (or anything other than the literal string "true") means the header is a
# silent no-op - only set this in a local/dev environment you're actively
# benchmarking, never in production, since it lets any authenticated caller
# force every request straight to Alchemy, bypassing the cache that
# normally absorbs repeat traffic.
ALLOW_CACHE_BYPASS=

# Not read by the app itself - this is what you export before running
# scripts/benchmark.mjs so it can authenticate as one of the values already
# configured above in API_KEYS. Kept as an env var (not a required
# --api-key flag) for the same reason API_KEYS itself is an env var: it
# keeps the key out of shell history and `ps`/process-list output.
API_KEY=
